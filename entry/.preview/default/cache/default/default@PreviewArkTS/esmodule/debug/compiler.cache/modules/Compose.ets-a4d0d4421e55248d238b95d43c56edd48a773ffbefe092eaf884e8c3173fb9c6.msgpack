import { DraftMessage, EmailAccount } from '../model/MailModels';

interface ComposeParams {
  accountId?: string;
  to?: string;
  subject?: string;
  body?: string;
}

@Entry
@Component
struct Compose {
  private repository: MockMailRepository = MockMailRepository.shared();
  @State private accounts: EmailAccount[] = [];
  @State private selectedAccountId: string = '';
  @State private to: string = '';
  @State private cc: string = '';
  @State private subject: string = '';
  @State private body: string = '';
  @State private isSending: boolean = false;

  aboutToAppear(): void {
    const params: ComposeParams = this.getUIContext().getRouter().getParams() as ComposeParams;
    this.to = params.to ?? '';
    this.subject = params.subject ?? '';
    this.body = params.body ?? '';
    this.loadAccounts(params.accountId ?? '');
  }

  private async loadAccounts(preferredAccountId: string): Promise<void> {
    this.accounts = await this.repository.listAccounts();
    if (preferredAccountId.length > 0) {
      this.selectedAccountId = preferredAccountId;
    } else if (this.accounts.length > 0) {
      this.selectedAccountId = this.accounts[0].id;
    }
  }

  private async send(): Promise<void> {
    if (this.to.trim().length === 0) {
      this.showToast('è¯·è¾“å…¥æ”¶ä»¶äºº');
      return;
    }
    this.isSending = true;
    try {
      await this.repository.send(new DraftMessage(this.selectedAccountId, this.to, this.cc, this.subject, this.body));
      this.showToast('é‚®ä»¶å·²å‘é€');
      this.getUIContext().getRouter().back();
    } catch (error) {
      this.showToast(`${error}`);
    } finally {
      this.isSending = false;
    }
  }

  private showToast(message: string): void {
    try {
      this.getUIContext().getPromptAction().showToast({ message: message });
    } catch (_error) {
    }
  }

  build() {
    Column() {
      Row() {
        Button('å–æ¶ˆ')
          .fontSize(15)
          .fontColor('#6F7689')
          .backgroundColor(Color.Transparent)
          .onClick(() => this.getUIContext().getRouter().back())
        Blank()
        Text('å†™é‚®ä»¶').fontSize(19).fontWeight(FontWeight.Bold).fontColor('#20283D')
        Blank()
        Button(this.isSending ? 'å‘é€ä¸­' : 'å‘é€')
          .fontSize(15)
          .fontColor('#FFFFFF')
          .backgroundColor('#3157D5')
          .height(38)
          .enabled(!this.isSending)
          .onClick(() => this.send())
      }
      .width('100%')
      .height(62)
      .padding({ left: 12, right: 16 })

      Scroll() {
        Column({ space: 0 }) {
          Row() {
            Text('å‘ä»¶äºº').width(66).fontSize(14).fontColor('#7A8195')
            Scroll() {
              Row({ space: 8 }) {
                ForEach(this.accounts, (account: EmailAccount) => {
                  Button(account.email)
                    .height(34)
                    .fontSize(13)
                    .fontColor(this.selectedAccountId === account.id ? '#FFFFFF' : '#596078')
                    .backgroundColor(this.selectedAccountId === account.id ? account.color : '#F0F2F7')
                    .borderRadius(17)
                    .onClick(() => this.selectedAccountId = account.id)
                }, (account: EmailAccount) => account.id)
              }
            }
            .layoutWeight(1)
            .scrollable(ScrollDirection.Horizontal)
            .scrollBar(BarState.Off)
          }
          .height(58)
          .width('100%')

          Divider().color('#ECEEF3')

          Row() {
            Text('æ”¶ä»¶äºº').width(66).fontSize(14).fontColor('#7A8195')
            TextInput({ placeholder: 'name@example.com', text: this.to })
              .layoutWeight(1)
              .height(54)
              .fontSize(15)
              .backgroundColor(Color.Transparent)
              .onChange((value: string) => this.to = value)
          }

          Divider().color('#ECEEF3')

          Row() {
            Text('æŠ„é€').width(66).fontSize(14).fontColor('#7A8195')
            TextInput({ placeholder: 'å¯é€‰', text: this.cc })
              .layoutWeight(1)
              .height(54)
              .fontSize(15)
              .backgroundColor(Color.Transparent)
              .onChange((value: string) => this.cc = value)
          }

          Divider().color('#ECEEF3')

          Row() {
            Text('ä¸»é¢˜').width(66).fontSize(14).fontColor('#7A8195')
            TextInput({ placeholder: 'é‚®ä»¶ä¸»é¢˜', text: this.subject })
              .layoutWeight(1)
              .height(54)
              .fontSize(15)
              .backgroundColor(Color.Transparent)
              .onChange((value: string) => this.subject = value)
          }

          Divider().color('#ECEEF3')

          TextArea({ placeholder: 'è¾“å…¥é‚®ä»¶æ­£æ–‡â€¦', text: this.body })
            .width('100%')
            .height(360)
            .fontSize(16)
            .lineHeight(25)
            .backgroundColor(Color.Transparent)
            .padding({ top: 18 })
            .onChange((value: string) => this.body = value)
        }
        .width('100%')
        .padding({ left: 20, right: 20 })
      }
      .layoutWeight(1)

      Row({ space: 24 }) {
        Text('âŒ•').fontSize(24).fontColor('#636B80')
        Text('â–§').fontSize(23).fontColor('#636B80')
        Text('A').fontSize(20).fontWeight(FontWeight.Bold).fontColor('#636B80')
        Blank()
        Text('â‹¯').fontSize(25).fontColor('#636B80')
      }
      .width('100%')
      .height(58)
      .padding({ left: 24, right: 24 })
      .backgroundColor('#F8F9FC')
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FFFFFF')
  }
}
