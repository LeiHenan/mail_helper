      Row() {
        Button('â€¹')
          .width(42).height(42).fontSize(30).fontColor('#263047')
          .backgroundColor(Color.Transparent)
          .onClick(() => this.getUIContext().getRouter().back())
        Text('æ·»åŠ é‚®ç®±').fontSize(22).fontWeight(FontWeight.Bold).fontColor('#20283D')
        Blank()
      }
      .width('100%')
      .padding({ left: 8, right: 18, top: 12, bottom: 8 })

      Scroll() {
        Column({ space: 18 }) {
          Text('é€‰æ‹©é‚®ç®±æœåŠ¡å•†')
            .width('100%').fontSize(15).fontWeight(FontWeight.Medium).fontColor('#596078')

          Grid() {
            ForEach(EMAIL_PROVIDERS, (provider: EmailProviderConfig) => {
              GridItem() {
                Column({ space: 9 }) {
                  Stack() {
                    Circle().width(46).height(46).fill(provider.color)
                    Text(provider.shortName).fontSize(16).fontWeight(FontWeight.Bold).fontColor('#FFFFFF')
                  }
                  Text(provider.name).fontSize(14).fontColor('#30384E')
                }
                .width('100%')
                .height(104)
                .justifyContent(FlexAlign.Center)
                .backgroundColor(this.selectedProvider === provider.type ? '#E9EEFF' : '#FFFFFF')
                .border({ width: this.selectedProvider === provider.type ? 2 : 1,
                  color: this.selectedProvider === provider.type ? '#3157D5' : '#EAECF2' })
                .borderRadius(16)
                .onClick(() => this.selectedProvider = provider.type)
              }
            }, (provider: EmailProviderConfig) => provider.type)
          }
          .columnsTemplate('1fr 1fr')
          .rowsGap(12)
          .columnsGap(12)
          .height(220)

          Column({ space: 12 }) {
            TextInput({ placeholder: 'è´¦æˆ·åç§°ï¼Œä¾‹å¦‚ï¼šå·¥ä½œé‚®ç®±', text: this.displayName })
              .height(52).fontSize(15).backgroundColor('#F4F5F8').borderRadius(13)
              .onChange((value: string) => this.displayName = value)

            TextInput({ placeholder: 'é‚®ç®±åœ°å€', text: this.email })
              .height(52).fontSize(15).backgroundColor('#F4F5F8').borderRadius(13)
              .type(InputType.Email)
              .onChange((value: string) => this.email = value)

            if (findProvider(this.selectedProvider).authType === AuthType.AUTHORIZATION_CODE) {
              TextInput({ placeholder: 'é‚®ç®±æˆæƒç ï¼ˆä¸æ˜¯ç™»å½•å¯†ç ï¼‰', text: this.secret })
                .height(52).fontSize(15).backgroundColor('#F4F5F8').borderRadius(13)
                .type(InputType.Password)
                .onChange((value: string) => this.secret = value)
            }
          }

          Text(findProvider(this.selectedProvider).helpText)
            .width('100%')
            .fontSize(13)
            .lineHeight(20)
            .fontColor('#7C8498')
            .padding(14)
            .backgroundColor('#EFF2F9')
            .borderRadius(12)

          Button(findProvider(this.selectedProvider).authType === AuthType.OAUTH_PKCE ?
            'ä½¿ç”¨ OAuth å®‰å…¨ç™»å½•' : (this.isConnecting ? 'æ­£åœ¨è¿æ¥â€¦' : 'è¿æ¥é‚®ç®±'))
            .width('100%')
            .height(52)
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor('#FFFFFF')
            .backgroundColor(findProvider(this.selectedProvider).color)
            .enabled(!this.isConnecting)
            .onClick(() => this.connect())

          Text('ç»§ç»­å³è¡¨ç¤ºä½ å…è®¸é‚®ç®±åŠ©æ‰‹åŒæ­¥é‚®ä»¶ã€‚å‡­è¯åº”ç”± HUKS åŠ å¯†ä¿å­˜ï¼ŒOAuth Token ç”±æœåŠ¡ç«¯å®‰å…¨äº¤æ¢ã€‚')
            .fontSize(12).lineHeight(18).fontColor('#9298A9').textAlign(TextAlign.Center)
        }
        .width('100%')
        .padding({ left: 20, right: 20, top: 10, bottom: 30 })
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F8F9FC')
  }
}
