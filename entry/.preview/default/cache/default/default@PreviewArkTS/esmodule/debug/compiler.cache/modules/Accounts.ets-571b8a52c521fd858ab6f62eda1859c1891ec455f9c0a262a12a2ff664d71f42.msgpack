import { EmailAccount } from '../model/MailModels';
import { findProvider } from '../model/ProviderConfig';

@Entry
@Component
struct Accounts {
  private repository: MockMailRepository = MockMailRepository.shared();
  @State private accounts: EmailAccount[] = [];

  aboutToAppear(): void {
    this.loadAccounts();
  }

  private async loadAccounts(): Promise<void> {
    this.accounts = await this.repository.listAccounts();
  }

  private async removeAccount(accountId: string): Promise<void> {
    await this.repository.removeAccount(accountId);
    await this.loadAccounts();
  }

  build() {
    Column() {
      Row() {
        Button('â€¹')
          .width(42).height(42).fontSize(30).fontColor('#263047')
          .backgroundColor(Color.Transparent)
          .onClick(() => this.getUIContext().getRouter().back())
        Text('é‚®ç®±è´¦æˆ·').fontSize(22).fontWeight(FontWeight.Bold).fontColor('#20283D')
        Blank()
        Button('æ·»åŠ ')
          .height(38).fontSize(14).fontColor('#3157D5').backgroundColor('#E9EEFF')
          .onClick(() => this.getUIContext().getRouter().pushUrl({ url: 'pages/AddAccount' }).catch(() => {}))
      }
      .width('100%')
      .padding({ left: 8, right: 18, top: 12, bottom: 12 })

      List({ space: 12 }) {
        ForEach(this.accounts, (account: EmailAccount) => {
          ListItem() {
            Column({ space: 14 }) {
              Row({ space: 13 }) {
                Stack() {
                  Circle().width(48).height(48).fill(account.color)
                  Text(findProvider(account.provider).shortName)
                    .fontSize(16).fontWeight(FontWeight.Bold).fontColor('#FFFFFF')
                }
                Column({ space: 4 }) {
                  Text(account.displayName).fontSize(17).fontWeight(FontWeight.Medium).fontColor('#242D44')
                  Text(account.email).fontSize(13).fontColor('#7B8296')
                }
                .alignItems(HorizontalAlign.Start)
                .layoutWeight(1)
                if (account.unreadCount > 0) {
                  Text(`${account.unreadCount}`)
                    .fontSize(12).fontColor('#FFFFFF').backgroundColor('#3157D5')
                    .borderRadius(12).padding({ left: 8, right: 8, top: 4, bottom: 4 })
                }
              }
              .width('100%')

              Divider().color('#ECEEF4')

              Row() {
                Text('åå°åŒæ­¥').fontSize(14).fontColor('#596078')
                Blank()
                Toggle({ type: ToggleType.Switch, isOn: account.syncEnabled })
                  .selectedColor('#3157D5')
                  .onChange((isOn: boolean) => account.syncEnabled = isOn)
                Button('ç§»é™¤')
                  .fontSize(13).fontColor('#D84B4B').backgroundColor('#FFF0F0')
                  .margin({ left: 12 })
                  .onClick(() => this.removeAccount(account.id))
              }
              .width('100%')
            }
            .width('100%')
            .padding(16)
            .backgroundColor('#FFFFFF')
            .borderRadius(18)
          }
        }, (account: EmailAccount) => account.id)
      }
      .layoutWeight(1)
      .width('100%')
      .padding({ left: 16, right: 16 })
      .scrollBar(BarState.Off)

      Column({ space: 6 }) {
        Text('éšç§ä¸å®‰å…¨').fontSize(14).fontWeight(FontWeight.Medium).fontColor('#394158')
        Text('åº”ç”¨åªä¿å­˜åŠ å¯†å‡­è¯å¼•ç”¨ï¼›OAuth é‚®ç®±ä¸ä¿å­˜å¯†ç ã€‚')
          .fontSize(12).fontColor('#878EA2').textAlign(TextAlign.Center)
      }
      .padding({ left: 24, right: 24, top: 12, bottom: 20 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F6F7FB')
