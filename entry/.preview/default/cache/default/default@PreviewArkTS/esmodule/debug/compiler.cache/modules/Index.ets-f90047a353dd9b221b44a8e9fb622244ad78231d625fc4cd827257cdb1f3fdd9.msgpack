import { EmailAccount, MailFolder, MailMessage } from '../model/MailModels';

@Entry
@Component
struct Index {
  private repository: MockMailRepository = MockMailRepository.shared();
  @State private accounts: EmailAccount[] = [];
  @State private messages: MailMessage[] = [];
  @State private selectedAccountId: string = 'all';
  @State private isRefreshing: boolean = false;

  aboutToAppear(): void {
    this.loadAccounts();
    this.loadMessages();
  }

  private async loadAccounts(): Promise<void> {
    this.accounts = await this.repository.listAccounts();
  }

  private async loadMessages(): Promise<void> {
    this.isRefreshing = true;
    this.messages = await this.repository.listMessages(this.selectedAccountId, MailFolder.INBOX);
    this.isRefreshing = false;
  }

  private selectAccount(accountId: string): void {
    this.selectedAccountId = accountId;
    this.loadMessages();
  }

  build() {
    Column() {
      Row() {
        Column({ space: 3 }) {
          Text('æ”¶ä»¶ç®±')
            .fontSize(28)
            .fontWeight(FontWeight.Bold)
            .fontColor('#17203A')
          Text(this.isRefreshing ? 'æ­£åœ¨åŒæ­¥â€¦' : `å…± ${this.messages.length} å°é‚®ä»¶`)
            .fontSize(13)
            .fontColor('#7D8499')
        }
        .alignItems(HorizontalAlign.Start)

        Blank()

        Button() {
          Text('â†»').fontSize(22).fontColor('#3157D5')
        }
        .width(42)
        .height(42)
        .backgroundColor('#E9EEFF')
        .borderRadius(21)
        .onClick(() => this.loadMessages())
      }
      .width('100%')
      .padding({ left: 20, right: 20, top: 18, bottom: 14 })

      Scroll() {
        Row({ space: 10 }) {
          Button('å…¨éƒ¨')
            .fontSize(14)
            .fontColor(this.selectedAccountId === 'all' ? '#FFFFFF' : '#4D5670')
            .backgroundColor(this.selectedAccountId === 'all' ? '#3157D5' : '#FFFFFF')
            .borderRadius(18)
            .height(36)
            .onClick(() => this.selectAccount('all'))

          ForEach(this.accounts, (account: EmailAccount) => {
            Button(`${account.displayName} ${account.unreadCount > 0 ? account.unreadCount : ''}`)
              .fontSize(14)
              .fontColor(this.selectedAccountId === account.id ? '#FFFFFF' : '#4D5670')
              .backgroundColor(this.selectedAccountId === account.id ? account.color : '#FFFFFF')
              .borderRadius(18)
              .height(36)
              .onClick(() => this.selectAccount(account.id))
          }, (account: EmailAccount) => account.id)
        }
        .padding({ left: 20, right: 20, bottom: 14 })
      }
      .width('100%')
      .scrollable(ScrollDirection.Horizontal)
      .scrollBar(BarState.Off)

      if (this.messages.length === 0 && !this.isRefreshing) {
        Column({ space: 12 }) {
          Text('âœ‰').fontSize(48)
          Text('æ”¶ä»¶ç®±æ˜¯ç©ºçš„').fontSize(18).fontWeight(FontWeight.Medium).fontColor('#30384F')
          Text('æ–°é‚®ä»¶ä¼šåœ¨åŒæ­¥åæ˜¾ç¤ºåœ¨è¿™é‡Œ').fontSize(14).fontColor('#8B91A3')
        }
        .layoutWeight(1)
        .width('100%')
        .justifyContent(FlexAlign.Center)
      } else {
        List({ space: 10 }) {
          ForEach(this.messages, (message: MailMessage) => {
            ListItem() {
              Row({ space: 12 }) {
                Stack() {
                  Circle()
                    .width(46)
                    .height(46)
                    .fill(message.isRead ? '#E8EAF0' : '#DDE6FF')
                  Text(message.sender.name.substring(0, 1))
                    .fontSize(17)
                    .fontWeight(FontWeight.Bold)
                    .fontColor(message.isRead ? '#73798C' : '#3157D5')
                }

                Column({ space: 5 }) {
                  Row() {
                    Text(message.sender.name)
                      .fontSize(16)
                      .fontWeight(message.isRead ? FontWeight.Regular : FontWeight.Bold)
                      .fontColor('#20283D')
                      .maxLines(1)
                    Blank()
                    Text(message.receivedAt).fontSize(12).fontColor('#8B91A3')
                  }
                  .width('100%')

                  Row({ space: 5 }) {
                    Text(message.subject)
                      .fontSize(15)
                      .fontWeight(message.isRead ? FontWeight.Regular : FontWeight.Medium)
                      .fontColor('#3A4258')
                      .maxLines(1)
                      .textOverflow({ overflow: TextOverflow.Ellipsis })
                    if (message.hasAttachments) {
                      Text('âŒ•').fontSize(13).fontColor('#8B91A3')
                    }
                    if (message.isStarred) {
                      Text('â˜…').fontSize(14).fontColor('#FFB33E')
                    }
                  }
                  .width('100%')

                  Text(message.preview)
                    .fontSize(13)
                    .fontColor('#8B91A3')
                    .maxLines(2)
                    .textOverflow({ overflow: TextOverflow.Ellipsis })
                    .width('100%')
                }
                .layoutWeight(1)
                .alignItems(HorizontalAlign.Start)
              }
              .width('100%')
              .padding(15)
              .backgroundColor('#FFFFFF')
              .borderRadius(18)
              .onClick(async () => {
                await this.repository.markRead(message.id);
                this.getUIContext().getRouter()
                  .pushUrl({ url: 'pages/MailDetail', params: { mailId: message.id } })
                  .catch(() => {});
              })
            }
          }, (message: MailMessage) => message.id)
        }
        .width('100%')
        .layoutWeight(1)
        .padding({ left: 14, right: 14, bottom: 8 })
        .scrollBar(BarState.Off)
      }

      Row() {
        Button() {
          Column({ space: 2 }) {
            Text('â–¤').fontSize(20).fontColor('#3157D5')
            Text('é‚®ä»¶').fontSize(11).fontColor('#3157D5')
          }
        }
        .layoutWeight(1)
        .height(58)
        .backgroundColor(Color.Transparent)

        Button() {
          Text('ï¼‹').fontSize(28).fontColor('#FFFFFF')
        }
        .width(54)
        .height(54)
        .borderRadius(27)
        .backgroundColor('#3157D5')
        .shadow({ radius: 18, color: '#553157D5', offsetY: 6 })
        .onClick(() => this.getUIContext().getRouter().pushUrl({ url: 'pages/Compose' }).catch(() => {}))

        Button() {
          Column({ space: 2 }) {
            Text('â—').fontSize(20).fontColor('#70778C')
            Text('è´¦æˆ·').fontSize(11).fontColor('#70778C')
          }
        }
        .layoutWeight(1)
        .height(58)
        .backgroundColor(Color.Transparent)
        .onClick(() => this.getUIContext().getRouter().pushUrl({ url: 'pages/Accounts' }).catch(() => {}))
      }
      .width('100%')
      .height(72)
      .padding({ left: 18, right: 18, bottom: 8 })
      .backgroundColor('#FFFFFF')
      .alignItems(VerticalAlign.Center)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F6F7FB')
  }
}
