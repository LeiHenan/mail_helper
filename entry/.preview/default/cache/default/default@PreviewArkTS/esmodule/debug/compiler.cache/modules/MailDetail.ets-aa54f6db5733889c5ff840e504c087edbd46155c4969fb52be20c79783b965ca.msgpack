import { MailMessage } from '../model/MailModels';

interface MailDetailParams {
  mailId: string;
}

@Entry
@Component
struct MailDetail {
  private repository: MockMailRepository = MockMailRepository.shared();
  @State private message?: MailMessage = undefined;

  aboutToAppear(): void {
    const params: MailDetailParams = this.getUIContext().getRouter().getParams() as MailDetailParams;
    this.loadMessage(params.mailId);
  }

  private async loadMessage(messageId: string): Promise<void> {
    this.message = await this.repository.getMessage(messageId);
  }

  build() {
    Column() {
      Row() {
        Button('â€¹')
          .width(42)
          .height(42)
          .fontSize(30)
          .fontColor('#263047')
          .backgroundColor(Color.Transparent)
          .onClick(() => this.getUIContext().getRouter().back())
        Blank()
        Button(this.message?.isStarred ? 'â˜…' : 'â˜†')
          .width(42)
          .height(42)
          .fontSize(23)
          .fontColor(this.message?.isStarred ? '#FFB33E' : '#687086')
          .backgroundColor(Color.Transparent)
          .onClick(async () => {
            if (this.message) {
              await this.repository.toggleStar(this.message.id);
              this.message = await this.repository.getMessage(this.message.id);
            }
          })
        Button('â‹¯')
          .width(42)
          .height(42)
          .fontSize(24)
          .fontColor('#687086')
          .backgroundColor(Color.Transparent)
      }
      .width('100%')
      .padding({ left: 10, right: 10, top: 10 })

      if (this.message) {
        Scroll() {
          Column({ space: 18 }) {
            Text(this.message.subject)
              .fontSize(25)
              .fontWeight(FontWeight.Bold)
              .fontColor('#1D263C')
              .width('100%')

            Row({ space: 12 }) {
              Stack() {
                Circle().width(48).height(48).fill('#DDE6FF')
                Text(this.message.sender.name.substring(0, 1))
                  .fontSize(18).fontWeight(FontWeight.Bold).fontColor('#3157D5')
              }
              Column({ space: 3 }) {
                Text(this.message.sender.name).fontSize(16).fontWeight(FontWeight.Medium).fontColor('#273048')
                Text(this.message.sender.address).fontSize(13).fontColor('#858CA0')
              }
              .alignItems(HorizontalAlign.Start)
              Blank()
              Text(this.message.receivedAt).fontSize(13).fontColor('#858CA0')
            }
            .width('100%')

            Divider().color('#ECEEF4')

            Text(this.message.plainBody)
              .fontSize(16)
              .lineHeight(26)
              .fontColor('#30384E')
              .width('100%')

            if (this.message.hasAttachments) {
              Row({ space: 12 }) {
                Text('â–§').fontSize(26).fontColor('#3157D5')
                Column({ space: 3 }) {
                  Text('è¯„å®¡ææ–™.pdf').fontSize(15).fontWeight(FontWeight.Medium).fontColor('#30384E')
                  Text('1.8 MB').fontSize(12).fontColor('#8B91A3')
                }.alignItems(HorizontalAlign.Start)
                Blank()
                Text('ä¸‹è½½').fontSize(14).fontColor('#3157D5')
              }
              .width('100%')
              .padding(14)
              .backgroundColor('#F3F5FA')
              .borderRadius(14)
            }
          }
          .padding({ left: 22, right: 22, bottom: 24 })
          .alignItems(HorizontalAlign.Start)
        }
        .layoutWeight(1)
        .scrollBar(BarState.Off)

        Row({ space: 12 }) {
          Button('å›å¤')
            .layoutWeight(1)
            .height(46)
            .fontColor('#3157D5')
            .backgroundColor('#E9EEFF')
            .onClick(() => this.getUIContext().getRouter().pushUrl({ url: 'pages/Compose', params: {
              accountId: this.message?.accountId,
              to: this.message?.sender.address,
              subject: `Re: ${this.message?.subject ?? ''}`
            } }).catch(() => {}))
          Button('è½¬å‘')
            .layoutWeight(1)
            .height(46)
            .fontColor('#FFFFFF')
            .backgroundColor('#3157D5')
            .onClick(() => this.getUIContext().getRouter().pushUrl({ url: 'pages/Compose', params: {
              accountId: this.message?.accountId,
              subject: `Fwd: ${this.message?.subject ?? ''}`,
              body: this.message?.plainBody
            } }).catch(() => {}))
        }
        .padding({ left: 20, right: 20, top: 10, bottom: 16 })
        .backgroundColor('#FFFFFF')
      } else {
        Column({ space: 12 }) {
          LoadingProgress().width(38).height(38).color('#3157D5')
          Text('æ­£åœ¨åŠ è½½é‚®ä»¶').fontSize(14).fontColor('#81889B')
        }
        .layoutWeight(1)
        .width('100%')
        .justifyContent(FlexAlign.Center)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FFFFFF')
  }
}
